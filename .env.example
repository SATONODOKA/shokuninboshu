# Firebase Configuration
# Firebase Console > プロジェクト設定 > 全般 > マイアプリ > Webアプリ から取得

VITE_FB_API_KEY=your_api_key_here
VITE_FB_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FB_PROJECT_ID=your_project_id
VITE_FB_STORAGE_BUCKET=your_project.appspot.com
VITE_FB_MESSAGING_SENDER_ID=your_sender_id
VITE_FB_APP_ID=your_app_id
VITE_FB_MEASUREMENT_ID=your_measurement_id

# App Configuration
VITE_APP_NAME=職人募集アプリ
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# API Configuration (if needed)
VITE_API_BASE_URL=https://your-api-endpoint.com
